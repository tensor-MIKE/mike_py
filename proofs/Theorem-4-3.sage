"""
This code accomponaies the proof of Theorem 4.12
in https://eprint.iacr.org/2026/2377.pdf

MIKE: a fast and compact post-quantum NIKE

The theorem states that
J_i = sum(X_k^i) for i = 1,2,3,4,5
are absolute invariants for the MIKE moduli space

here I_MIKE = (X0 : ... : X9).
"""


print("STEP 1 (Lemma H.7)")
# we show that G = <sigma1,sigma2> is precisely the
# subgroup of S9 that fixes the relations among the
# MIKE invariants X0, ..., X9

S9 = SymmetricGroup(9)
sigma1 = S9([1,2,3,5,4,7,6,9,8])
sigma2 = S9([7,1,6,2,3,5,9,4,8])
G = S9.subgroup([sigma1,sigma2])


R.<X1,X2,X3,X4,X5,X6,X7,X8,X9> = QQ[]
XX = R.gens()
# relations from Lemma H.6
X0 = X3 + X5 + X7 + X8 - X9
Rels = [
-X1 + X3 + X7 - X9,
-X2 + X3 + X5 - X9,
-X4 + X5 + X8 - X9,
-X6 + X7 + X8 - X9
]
I0 = R.ideal(Rels)

good = []
for sigma in S9:
	YY = sigma(XX)
	if all([el(YY) in I0 for el in Rels]):
		good.append(sigma)

print(sigma1 in good)
print(sigma2 in good)
print(len(good) == G.order())


print("STEP 2 (Lemma H.8)")
# We show that given J1,J2,J3,J4,J5, we can construct
# the invariants I0, ..., I9 up to permutation in S_{10}

# It suffices to work with X3,X5,X7,X8,X9 as variables
R.<X3,X5,X7,X8,X9> = QQ[]
X0 = X3 + X5 + X7 + X8 - X9
X1 = X3 + X7 - X9
X2 = X3 + X5 - X9
X4 = X5 + X8 - X9
X6 = X7 + X8 - X9

XX = [X1,X2,X3,X4,X5,X6,X7,X8,X9]

# Step 2a: we first show that this is true using the auxiliary element J6
J1 = sum(XX)
J2 = sum([Xi^2 for Xi in XX])
J3 = sum([Xi^3 for Xi in XX])
J4 = sum([Xi^4 for Xi in XX])
J5 = sum([Xi^5 for Xi in XX])
J6 = sum([Xi^6 for Xi in XX])


JJ = [J1,J2,J3,J4,J5,J6]
S.<Y> = R[]
# the elements in TT are absolute invariants for I0, ..., I9 under
# the action of S_{10}
TT = [X0^k +  sum(Xi^k for Xi in XX) for k in range(1,11)]


# we write each element of TT an element in the
# algebra k[J1,J2,J3,J4,J5,J6]

def all_monomials(R,deg):
	xx = R.gens()
	degs = WeightedIntegerVectors(deg, [1 for el in xx])
	mons = [prod([xx[i]^d[i] for i in range(len(xx))]) for d in degs]
	return mons

def degree_d_elements(J,d):
	"""
	returns all elements of degree d in the algebra
	generated by J1,J2,J3,J4,J5,J6
	"""
	assert len(J) == 6
	part_d = Partitions(d, max_part=6).list()
	return [prod([J[i-1] for i in p]) for p in part_d]

def find_representation(rep_list, elt):
	d = elt.degree()
	monsd = all_monomials(R, d)
	M = Matrix([[rep.monomial_coefficient(m) for m in monsd] for rep in rep_list])
	y = vector([elt.monomial_coefficient(m) for m in monsd])
	return M.solve_left(y)


for i in range(10):
	d = i+1
	print("checking containment for d = ", d)
	D_d = degree_d_elements(JJ,d)
	vi = find_representation(D_d,TT[i])
	#print(gcd(vi).factor())
	print("relation", vi/gcd(vi))
	print()


# Step 2b
# We now show that J6 can be expressed
# as a rational function in [J1,J2,J3,J4,J5]

def find_relations(rep_list):
	d = rep_list[0].degree()
	monsd = all_monomials(R, d)
	M = Matrix([[rep.monomial_coefficient(m) for m in monsd] for rep in rep_list])
	return M.left_kernel()

for i in range(10):
	d = i+1
	D_d = degree_d_elements(JJ,d)
	V = find_relations(D_d)
	if V.dimension() > 0:
		v = V.basis()[0]
		print(v)

print("relation among J1, ..., J6")
print(list(v) == [1, -4/9, -1/4, 7/54, -7/972, -6/25, -2/5, 1/3, 1/5, 1/18, -8/135, 131/36450, -7/12, 19/108, -11/18, 20/27, -35/243, 31/144, -91/432, 509/11664, -341/174960, 22/81, 1/27, -25/81, 145/4374, -13/108, 41/324, -19/972, 293/393660, -5/288, 77/2592, -25/1458, 157/52488, -23/116640, 23/5248800])
#sanity check
assert 0 == sum([v[i]*D_d[i] for i in range(len(D_d))])

# write it as a symbolic expression
K.<Y1,Y2,Y3,Y4,Y5,Y6> = QQ[]
JJ_s = K.gens()
D_10 = degree_d_elements(JJ_s,10)
relation = 15746400*sum([v[i]*D_10[i] for i in range(len(D_10))])
q,r = relation.quo_rem(Y6)
q = -7*Y1^4 + 126*Y1^2*Y2 - 243*Y2^2 - 432*Y1*Y3 + 972*Y4
r = 69*Y1^10 - 3105*Y1^8*Y2 + 47100*Y1^6*Y2^2 + 11720*Y1^7*Y3 - 270000*Y1^4*Y2^3 - 307800*Y1^5*Y2*Y3 - 30690*Y1^6*Y4 + 467775*Y1^2*Y2^4 + 1992600*Y1^3*Y2^2*Y3 + 522000*Y1^4*Y3^2 + 687150*Y1^4*Y2*Y4 + 56592*Y1^5*Y5 - 273375*Y2^5 - 1895400*Y1*Y2^3*Y3 - 4860000*Y1^2*Y2*Y3^2 - 3316950*Y1^2*Y2^2*Y4 - 2268000*Y1^3*Y3*Y4 - 933120*Y1^3*Y2*Y5 + 583200*Y2^2*Y3^2 + 4276800*Y1*Y3^3 + 3389850*Y2^3*Y4 + 11664000*Y1*Y2*Y3*Y4 + 2770200*Y1^2*Y4^2 + 874800*Y1*Y2^2*Y5 + 3149280*Y1^2*Y3*Y5 - 9622800*Y3^2*Y4 - 9185400*Y2*Y4^2 + 5248800*Y2*Y3*Y5 - 6298560*Y1*Y4*Y5 - 3779136*Y5^2
assert 16200*q*Y6 + r == relation


print("STEP 3 (Lemma H.9)")
# We show that the invariants are absolute (not only generically)
R.<X1,X2,X3,X4,X5,X6,X7,X8,X9> = QQ[]
XX = R.gens()
X0 = X3 + X5 + X7 + X8 - X9
Rels = [
-X1 + X3 + X7 - X9,
-X2 + X3 + X5 - X9,
-X4 + X5 + X8 - X9,
-X6 + X7 + X8 - X9
]
I0 = R.ideal(Rels)

S9 = SymmetricGroup(9)
sigma1 = S9([1,2,3,5,4,7,6,9,8])
sigma2 = S9([7,1,6,2,3,5,9,4,8])
G = S9.subgroup([sigma1,sigma2])

def compute_sum(I, sigma):
	J = R.ideal([f(sigma(XX)) for f in I.gens()])
	return I + J

counter = 0
for sigma in S9: #obviously
	IJ = compute_sum(I0, sigma)
	YY = [Xi.reduce(IJ) for Xi in XX]
	# sanity check
	for f in I0.gens():
		assert f(sigma(YY)) in I0
	Z = sigma(YY)
	found = False
	for g in G:
		if g(YY) == Z:
			found = True
			break
	if found == False:
		print("exception:", sigma)
	counter += 1
	if counter % 10000 == 0:
		print("progress:", counter, "of ", 362880)
